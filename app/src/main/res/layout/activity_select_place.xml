<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#F9FAFB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvHeader"
            android:text="Découvre ton pays 🌍"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Lieux à visiter -->
        <TextView
            android:text="🏛️ Lieux à visiter"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ListView
            android:id="@+id/listPlaces"
            android:divider="#E2E8F0"
            android:dividerHeight="1dp"
            android:background="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:elevation="4dp"/>

        <!-- Activités -->
        <TextView
            android:text="🎯 Activités à faire"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ListView
            android:id="@+id/listActivities"
            android:divider="#E2E8F0"
            android:dividerHeight="1dp"
            android:background="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:elevation="4dp"/>

        <Button
            android:id="@+id/btnPlanBudget"
            android:text="💶 Planifier mon budget"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:background="@drawable/gradient_button"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
